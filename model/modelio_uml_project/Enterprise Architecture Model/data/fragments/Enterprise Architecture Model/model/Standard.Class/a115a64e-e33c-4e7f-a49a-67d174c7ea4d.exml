      <COMP relation="Properties">
        <OBJECT>
          <ID name="019b5920-7db9-4bf8-8954-032fccc94563" mc="Infrastructure.TypedPropertyTable" uid="8ef39f14-fb6a-4d4e-b68d-d03c5abd4284"/>
          <ATTRIBUTES>
            <ATT name="Name"><![CDATA[019b5920-7db9-4bf8-8954-032fccc94563]]></ATT>
            <ATT name="Content"><![CDATA[#Wed Sep 30 08:07:56 CEST 2026
graphRagAnchor=true
graphRagGroup=integration
graphRagExtractionHints=Exchanges appear in 'System Interfaces', 'Process/Data Flows', 'Data Exchanges' tables (Table 6), 'Web Service Interfaces', 'File Transfer Interfaces', 'Interfaces externes', 'Flux métier' / 'Flux exploitation' / 'Flux techniques' tables (with columns source, destination, protocole, port, fréquence, volumétrie), and in text ('Approximately 50 federal, state, and local applications connect to DMV systems'). One entity per named file, service or flow; when a document lists an interface between two systems without a name, name it '<source> to <target>'. Point source and target at ApplicationSystem entities, creating the partner system when needed.
]]></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Type">
              <FOREIGNID name="PropertyTableDefinition" mc="Infrastructure.PropertyTableDefinition" uid="497feb8b-7955-4f5a-86e3-441d665b6643"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
      </COMP>
      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="eb1ff5be-a2e5-4cc0-a02d-b0c790a09530"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[An interface or data flow between two systems: a file transfer over SFTP, a web service or REST API call, a message queue, an EDI transaction, a database extract, a batch feed. Described in interface control documents (ICD), interface specifications, 'System Interfaces' sections and 'flux' sections of French technical architecture documents.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
