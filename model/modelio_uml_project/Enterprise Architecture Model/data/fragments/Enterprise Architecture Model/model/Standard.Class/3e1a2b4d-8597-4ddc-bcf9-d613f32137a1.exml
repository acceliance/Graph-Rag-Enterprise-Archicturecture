          <ID name="019b5920-7db9-4bf8-8954-032fccc94563" mc="Infrastructure.TypedPropertyTable" uid="6eb70beb-b808-4491-ad16-dc70fd7681bc"/>
          <ATTRIBUTES>
            <ATT name="Name"><![CDATA[019b5920-7db9-4bf8-8954-032fccc94563]]></ATT>
            <ATT name="Content"><![CDATA[#Wed Sep 30 08:07:56 CEST 2026
graphRagAnchor=true
graphRagGroup=governance
graphRagExtractionHints=Exactly one entity per PDF\: the document being read. Title, version, date, issuer and reference are on the cover page and in the page header or footer; the revision history is on the pages that follow. Keep the version out of the title so that successive editions of the same document merge (System Design Document v5 and v7 are one document with two revisions). Documents referenced in 'Reference Documents' or 'Documents de référence' are NOT extracted as ArchitectureDocument.
]]></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Type">
              <FOREIGNID name="PropertyTableDefinition" mc="Infrastructure.PropertyTableDefinition" uid="497feb8b-7955-4f5a-86e3-441d665b6643"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
      </COMP>
      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="113569dc-a17a-495b-acee-4c1617a826b3"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[The architecture document itself: an enterprise architecture blueprint, a technical architecture document (dossier d'architecture technique, DAT), a system design document (SDD), a software architecture document (SAD), an interface control document (ICD), an IT master plan (schéma directeur du SI, SDSI), a self-assessment or an audit report. Its revisions are value objects.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
