      <COMP relation="Properties">
        <OBJECT>
          <ID name="019b5920-7db9-4bf8-8954-032fccc94563" mc="Infrastructure.TypedPropertyTable" uid="788d5c4f-caf3-450a-a77d-31ddfa1d67f3"/>
          <ATTRIBUTES>
            <ATT name="Name"><![CDATA[019b5920-7db9-4bf8-8954-032fccc94563]]></ATT>
            <ATT name="Content"><![CDATA[#Wed Sep 30 08:07:56 CEST 2026
graphRagFuzzyThreshold=0.90
graphRagGroup=infrastructure
graphRagReviewBand=0.75
graphRagExtractionHints=Technologies appear in standards catalogs as 'Component / Standard / Version' columns, in 'Third Party Components', 'COTS', 'Composants logiciels utilisés', 'Biblothèques structurantes' and 'Requis' lists, in infrastructure descriptions ('serveurs Linux (Ubuntu 22.04)', 'Base de données \: MySQL 8') and in text ('Oracle SQL database', 'Shibboleth for authentication'). One entity per product, with the version in version, not in the name. Vendors go to the Organisation class and are linked through vendor.
graphRagMatch=fuzzy
]]></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Type">
              <FOREIGNID name="PropertyTableDefinition" mc="Infrastructure.PropertyTableDefinition" uid="497feb8b-7955-4f5a-86e3-441d665b6643"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
      </COMP>
      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="033f3570-2aa8-4114-81a3-d7d2e0da2eb2"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[A technology product, platform, protocol or standard named in the documents: an operating system (Windows Server, Solaris, Ubuntu 22.04), a database (Oracle, MySQL 8, MongoDB, SQL Server), middleware (WebSphere, ESB, Elasticsearch), network or security equipment (Cisco Nexus, Palo Alto, Aruba), storage (Swift, S3, Nimble), an end-user device (Dell Optiplex), a language or framework (PHP, J2EE, .NET) or a standard or protocol (OAIS, HIPAA 5010, X12 834, SFTP, TLS, REST).]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
