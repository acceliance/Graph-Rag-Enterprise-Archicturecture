# =============================================================================
#  Acceliance Graph-RAG — environment (copy to .env, never commit .env)
#
#  scripts/up.sh and scripts/up.ps1 create .env from this file and fill in the
#  two secrets automatically. Doing it by hand: set the two REQUIRED lines.
# =============================================================================

# ── REQUIRED secrets ─────────────────────────────────────────────────────────
#  No fallback: docker compose refuses to start without them.
#  Generate (bash):        openssl rand -base64 24 | tr -d '+/='
#  Generate (PowerShell):  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#  Avoid $ ` " and \ in NEO4J_PASSWORD: it is reassembled into "neo4j/<password>".
NEO4J_PASSWORD=
QDRANT_API_KEY=

# ── Product images (pinned release tags; `latest` on purpose commented out) ──
#  Published on Docker Hub, public — no login needed. Update both together.
GRAPHRAG_API_IMAGE=acceliance/graphrag-api:latest
GRAPHRAG_WEB_IMAGE=acceliance/graphrag-web:latest

# ── Datastore images ─────────────────────────────────────────────────────────
#  Exact patch versions verified on Docker Hub on 2026-09-21. Neo4j 5.26 is the
#  LTS line; Qdrant 1.15 is the line the API is tested against.
QDRANT_TAG=v1.15.5
NEO4J_TAG=5.26.30-community

# ── Network ──────────────────────────────────────────────────────────────────
#  The only published port. Behind a reverse proxy on the same host, bind to
#  127.0.0.1 so the plain-HTTP port is not reachable from the network.
GRAPHRAG_HTTP_BIND=0.0.0.0
GRAPHRAG_HTTP_PORT=8080

# ── Session ──────────────────────────────────────────────────────────────────
#  `Secure` cookie ⇒ the site MUST be served over HTTPS (reverse proxy).
#  false only for a pilot reached over plain http://host:8080.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=43200

# ── Sizing (see README "Sizing") ─────────────────────────────────────────────
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G
#  true keeps vectors on disk (large corpora on hosts under 16 GB RAM).
QDRANT_ON_DISK_VECTORS=false

# ── Ingestion limits ─────────────────────────────────────────────────────────
GRAPHRAG_MAX_UPLOAD_MB=50
GRAPHRAG_MAX_PAGES=500
#  Tesseract languages used for pages without a text layer (packs shipped in
#  the image: fra, eng).
GRAPHRAG_OCR_LANGS=fra+eng
#  Auto-purge documents older than N days (0 = off).
GRAPHRAG_RETENTION_DAYS=0

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERS=10
AGENT_MAX_TOKENS=4096

# ── MCP (external AI hosts) ──────────────────────────────────────────────────
#  Leave MCP_ENABLED unset to administer the switch from Admin ▸ MCP.
#  MCP_ENABLED=false locks the feature for this deployment.
# MCP_ENABLED=
#  REQUIRED as soon as a host connects through anything but localhost, else
#  every client gets 421. Host AND port actually used by clients:
#     graphrag.example.com:*      one host, any port
#     *                           disables the check (only behind a trusted edge)
# MCP_ALLOWED_HOSTS=graphrag.example.com:*
# MCP_ALLOWED_ORIGINS=

# ── Misc ─────────────────────────────────────────────────────────────────────
TZ=Europe/Paris
#  Escape hatch, never for production: run without a Qdrant API key.
GRAPHRAG_ALLOW_UNSECURED_QDRANT=false

# ── NOT configured here, on purpose ──────────────────────────────────────────
#  AI provider keys (Anthropic, OpenAI), on-premises server URL and context
#  window, model names for the chat / extraction / embedding slots: entered
#  after installation from Admin ▸ AI settings, stored under ./data/api, and
#  re-read on every request. Keeping them out of this file means no deployment
#  input ever holds a secret.
