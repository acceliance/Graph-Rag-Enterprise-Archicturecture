# Acceliance Graph-RAG — nginx front door example (TLS termination on the host).
# Assumes the stack binds to 127.0.0.1:8080 (GRAPHRAG_HTTP_BIND=127.0.0.1 in .env).
# Certificates: use certbot or your CA; only the proxy block matters here.

server {
    listen 80;
    server_name graphrag.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name graphrag.example.com;

    ssl_certificate     /etc/letsencrypt/live/graphrag.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/graphrag.example.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # >= GRAPHRAG_MAX_UPLOAD_MB, with headroom for multipart overhead
    client_max_body_size 60m;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        # Keep the port in Host: the MCP endpoint's anti-DNS-rebinding
        # allow-list (MCP_ALLOWED_HOSTS) is matched on this value.
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # The agent loop can take minutes; the edge waits longer than its budget.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
